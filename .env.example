# =============================================================================
# Omada MCP Server — environment configuration
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# REQUIRED — only these three are needed for a working setup
# ---------------------------------------------------------------------------
OMADA_BASE_URL=https://your-instance.omada.cloud
TENANT_ID=your-azure-ad-tenant-id
CLIENT_ID=your-mcp-client-app-registration-client-id  # the MCP client app, NOT the Omada app

# ---------------------------------------------------------------------------
# OPTIONAL — all of these have sensible defaults
# ---------------------------------------------------------------------------

# Override the OAuth2 scope if your Omada app uses a non-standard identifier URI.
# Default: {OMADA_BASE_URL}/user_impersonation offline_access
# OAUTH2_SCOPE=https://your-instance.omada.cloud/user_impersonation offline_access

# Local callback port for the auth browser redirect. Must match the redirect URI
# configured on the Azure AD app registration.
# Default: 8765
# REDIRECT_PORT=8765

# GraphQL API version.
# Default: 3.0
# GRAPHQL_ENDPOINT_VERSION=3.0

# Response caching — reduces API calls for repeated queries.
# Default: true, 3600 seconds
# CACHE_ENABLED=true
# CACHE_TTL_SECONDS=3600

# Impersonation — requires the authenticating account to be a member of
# ImpersonationServiceUsers in Omada. Leave blank for normal user auth.
# IMPERSONATE_USER=serviceaccount@yourdomain.com

# HTTP client options
# User-Agent sent with every API request. Default: omada-mcp-server/1.0
# HTTP_USER_AGENT=omada-mcp-server/1.0
# Retry settings for transient network failures (max attempts, base backoff in seconds).
# Set HTTP_RETRY_MAX=1 to disable retries.
# HTTP_RETRY_MAX=3
# HTTP_RETRY_BACKOFF=1.0

# Log level: DEBUG, INFO, WARNING, ERROR. Default: INFO
# LOG_LEVEL=INFO

# Per-tool log level overrides
# LOG_LEVEL_get_pending_approvals=DEBUG
# LOG_LEVEL_create_access_request=DEBUG
# LOG_LEVEL_make_approval_decision=DEBUG
